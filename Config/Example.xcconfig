//
//  Example.xcconfig
//  Rowing Pals
//
//  Template for Debug.xcconfig / Staging.xcconfig / Release.xcconfig.
//  Copy this file to the PROJECT ROOT (not this Config/ folder — that's
//  where Xcode's "Base Configuration File" picker put the real ones when
//  they were set up), rename it to match the configuration, and fill in
//  real values. The real files are gitignored — never commit one with a
//  real key.
//

// xcconfig treats // as a comment start, so a literal "//" in a value (like
// a URL scheme) gets truncated unless split with an empty macro reference.
SUPABASE_URL = https:/$()/example.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
